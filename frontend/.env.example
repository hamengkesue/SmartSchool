# URL Backend FastAPI di Production (Render.com) atau Domain Kustom Anda
NEXT_PUBLIC_FASTAPI_URL=https://smartschool-api.onrender.com

# n8n Automation Webhook (kosongkan jika tidak menggunakan n8n di production)
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Mode Aplikasi & Fallback
NEXT_PUBLIC_USE_MOCK_FALLBACK=false
NEXT_PUBLIC_APP_NAME="SmartSchool AI"
NEXT_PUBLIC_APP_VERSION="1.0.0"
